<Window x:Class="WpfApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="540"
        Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="22"
            Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Storage"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExportPathTextBox"
                                 Width="300"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0"
                                 Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Height="34"
                                Margin="0,0,10,0"
                                Click="BrowseButton_Click"
                                Background="{DynamicResource ButtonBackground}"
                                BorderBrush="{DynamicResource ButtonBackground}"/>
                    </Grid>

                    <TextBlock Text="Theme"
                               Margin="0,20,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Light"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <ToggleButton x:Name="DarkThemeToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Height="34"
                                      VerticalContentAlignment="Center"/>
                        <TextBlock Text="Dark"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>

                    <TextBlock Text="Reminders"
                               Margin="0,20,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Off"
                                   VerticalAlignment="Center"
                                   Margin="5,0,10,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <ToggleButton x:Name="ReminderToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Margin="5,0,5,0"
                                      Height="34"
                                      VerticalContentAlignment="Center"/>
                        <TextBlock Text="On"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                    <!-- Gambling Apps -->
                    <TextBlock Text="Gambling Apps"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,20,0,8"/>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,10,16">  
                        <StackPanel>
                            <ListBox x:Name="GamblingAppsList"
                                     Height="150"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     Margin="0,0,0,8"/>     
                            <StackPanel Orientation="Horizontal">
                                <Button Content="+ Add"
                                        Width="73" Height="30"
                                        Margin="0,0,8,0"
                                        Click="AddGamblingApp_Click"
                                        Background="{DynamicResource ButtonBackground}"
                                        BorderBrush="{DynamicResource ButtonBackground}"/>  
                                <Button Content="Remove"
                                        Width="84" Height="30"
                                        Click="RemoveGamblingApp_Click"
                                        Background="{DynamicResource ButtonBackground}"
                                        BorderBrush="{DynamicResource ButtonBackground}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,28,0,0">
                <Button Content="Cancel"
                        Width="86"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click" 
                        Background="{DynamicResource ButtonBackground}"
                        BorderBrush="{DynamicResource ButtonBackground}"/>
                <Button Content="Apply"
                        Width="86"
                        Height="34"
                        Click="ApplyButton_Click" 
                        Background="{DynamicResource ButtonBackground}"
                        BorderBrush="{DynamicResource ButtonBackground}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
