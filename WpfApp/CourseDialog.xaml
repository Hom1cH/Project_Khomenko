<Window x:Class="WpfApp.CourseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add course"
        Width="430"
        Height="525"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F7FB">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Add course"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,18" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Title" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="TitleTextBox" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,10" />

            <TextBlock Text="Difficulty" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="DifficultyTextBox" Grid.Row="1" Grid.Column="1" Height="30" Text="50" Margin="0,0,0,10" />

            <TextBlock Text="Credits" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="CreditsTextBox" Grid.Row="2" Grid.Column="1" Height="30" Text="1" Margin="0,0,0,10" />

            <TextBlock Text="Progress" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="ProgressTextBox" Grid.Row="3" Grid.Column="1" Height="30" Text="0" Margin="0,0,0,10" />

            <TextBlock Text="Deadline" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10" />
            <DatePicker x:Name="DeadlinePicker" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,10" />

            <TextBlock Text="Tags" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="TagsTextBox"
                     Grid.Row="5"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10"
                     ToolTip="Separate tags with commas" />

            <TextBlock Text="Description" Grid.Row="6" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,12,0" />
            <TextBox x:Name="DescriptionTextBox"
                     Grid.Row="6"
                     Grid.Column="1"
                     MinHeight="86"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="86" Height="32" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="Add" Width="86" Height="32" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
