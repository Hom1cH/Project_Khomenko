<Window x:Class="WpfApp.GamblingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎰 Gambling"
        Height="200"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Карусель -->
        <Border Grid.Row="0"
                Margin="30,30,30,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <!-- Стрічка іконок -->
                <Canvas x:Name="CarouselCanvas"
                        Height="120"
                        ClipToBounds="True">
                    <StackPanel x:Name="IconStrip"
                                Orientation="Horizontal"
                                Canvas.Top="10">
                        <!-- Іконки генеруються з коду -->
                    </StackPanel>
                </Canvas>

                <!-- Затемнення по краях -->
                <Rectangle HorizontalAlignment="Left" Width="60">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource SurfaceColor}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle HorizontalAlignment="Right" Width="60">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="{DynamicResource SurfaceColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Стрілочка зверху по центру -->
                <Path Data="M 0,0 L 12,14 L 24,0 Z"
                      Fill="{DynamicResource GamblingFill}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,4,0,0"
                      IsHitTestVisible="False"/>    
            </Grid>
        </Border>

        <!-- Назва програми що випала -->
        <TextBlock x:Name="ResultText"
                   Grid.Row="1"
                   Text=""
                   FontSize="16"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,12"/>
    </Grid>
</Window>