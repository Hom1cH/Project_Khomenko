<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Education Dashboard"
        Height="900"
        Width="1600"
        MinHeight="680"
        MinWidth="980"
        Background="#F4F7FB"
        >
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <local:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="26,26,48,26">

            <!-- ========================== Courses Cards =======================================-->
            <Grid x:Name="CoursesView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="All courses"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#101828" />
                    <TextBlock Text="Click a course card to inspect its tasks."
                       Foreground="#667085"
                       Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer
                              VerticalScrollBarVisibility="Hidden" Margin="0,75,0,0" Grid.RowSpan="2">
                    <ItemsControl x:Name="CourseCards" ItemsSource="{Binding Courses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="345"
                                      MinHeight="360"
                                      Margin="0,0,22,22">
                                    <Button Click="CourseCard_Click"
                                    Tag="{Binding}"
                                    Width="345"
                                    MinHeight="400"
                                    Margin="0"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Cursor="Hand">
                                        <Border Background="White"
                                        CornerRadius="8"
                                        Width="345"
                                        MinHeight="400"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Padding="0">
                                            <StackPanel>
                                                <Border Background="{Binding HeaderBackground}"
                                                        CornerRadius="8,8,0,0"
                                                        Padding="18">
                                                    <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}"      
                                                               Width="280"
                                                               HorizontalAlignment="Left"
                                                        FontSize="24"
                                                        FontWeight="SemiBold"
                                                        Foreground="#111827"
                                                        TextTrimming="CharacterEllipsis" 
                                                           />
                                                </DockPanel>
                                                <Border DockPanel.Dock="Right"
                                                    Background="#ECFDF3"
                                                    CornerRadius="5"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    >

                                                    <TextBlock Text="{Binding Status}"
                                                        FontSize="11"
                                                        Foreground="#027A48"
                                                        FontWeight="SemiBold"
                                                        PreviewMouseLeftButtonDown="Status_PreviewMouseLeftButtonDown"
                                                        Tag="{Binding}">
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="NotStarted"
                                                                          Command="{Binding Data.SetCourseNotStartedCommand, Source={StaticResource ViewModelProxy}}"
                                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="InProgress"
                                                                          Command="{Binding Data.SetCourseInProgressCommand, Source={StaticResource ViewModelProxy}}"
                                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Completed"
                                                                          Command="{Binding Data.SetCourseCompletedCommand, Source={StaticResource ViewModelProxy}}"
                                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Paused"
                                                                          Command="{Binding Data.SetCoursePausedCommand, Source={StaticResource ViewModelProxy}}"
                                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Archived"
                                                                          Command="{Binding Data.SetCourseArchivedCommand, Source={StaticResource ViewModelProxy}}"
                                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                </Border>
                                                        <ItemsControl ItemsSource="{Binding TagItems}" Margin="0,6,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding Background}"
                                                                            BorderBrush="{Binding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="5"
                                                                            Padding="8,3"
                                                                            Margin="0,0,6,6">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontSize="11"
                                                                                   Foreground="{Binding Foreground}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="18">
                                                <TextBlock Text="{Binding Description}"
                                                    Foreground="#667085"
                                                    TextWrapping="Wrap"
                                                    MaxHeight="40"
                                                    TextTrimming="CharacterEllipsis"
                                                    Margin="0,8,0,14" />
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                                    Height="10"
                                                    Maximum="100"
                                                    Margin="0,0,0,12" />
                                                <UniformGrid Columns="3"
                                                             Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="Progress" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Tasks" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding TaskCount}" Style="{StaticResource MetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Difficulty" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding Difficulty}" Style="{StaticResource MetricValue}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="Credits" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding ReceivedCreditsText}" FontWeight="SemiBold" Foreground="#111827" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,8">
                                                        <TextBlock Text="Workload" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding Workload}" FontWeight="SemiBold" Foreground="#111827" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,8">
                                                        <TextBlock Text="Created" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding CreatedAtText}" FontWeight="SemiBold" Foreground="#111827" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="Deadline" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding DeadlineText}" FontWeight="SemiBold" Foreground="#111827" />
                                                    </StackPanel>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="Ended" Style="{StaticResource MetricLabel}" />
                                                            <TextBlock Text="{Binding EndedAtText}" FontWeight="SemiBold" Foreground="#111827" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Button Width="28"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,10,10,0"
                                        Content="..."
                                        FontWeight="Bold"
                                        Padding="0"
                                        Click="CourseCardSettings_Click"
                                        Tag="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Изменить" Click="EditCourseMenuItem_Click" />
                                                <MenuItem Header="Удалить"
                                                          Command="{Binding Data.DeleteCourseCommand, Source={StaticResource ViewModelProxy}}"
                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <!-- ========================== TaskCards =======================================-->
            <Grid x:Name="TasksView"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,18">
                    <Button Content="Back"
                            Width="86"
                            Height="34"
                            DockPanel.Dock="Left"
                            Command="{Binding BackCommand}" />
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock x:Name="SelectedCourseTitle"
                                   Text="{Binding SelectedCourseTitle}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#101828" />
                        <TextBlock x:Name="SelectedCourseSubtitle"
                                   Text="{Binding SelectedCourseSubtitle}"
                                   Foreground="#667085"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="TaskCards" ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="345"
                                      MinHeight="320"
                                      Margin="0,0,22,22">
                                    <Border Width="345"
                                        MinHeight="320"
                                        Margin="0"
                                        Background="White"
                                        CornerRadius="8"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Padding="0">
                                        <StackPanel>
                                            <Border Background="{Binding HeaderBackground}"
                                                    CornerRadius="8,8,0,0"
                                                    Padding="18">
                                                <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   TextWrapping="Wrap" />
                                            <Border DockPanel.Dock="Right"
                                                    Background="#ECFDF3"
                                                    CornerRadius="5"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}"
                                                        FontSize="11"
                                                        Foreground="#027A48"
                                                        FontWeight="SemiBold"
                                                        PreviewMouseLeftButtonDown="Status_PreviewMouseLeftButtonDown"
                                                        Tag="{Binding}">
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="NotStarted"
                                                                      Command="{Binding Data.SetTaskNotStartedCommand, Source={StaticResource ViewModelProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="InProgress"
                                                                      Command="{Binding Data.SetTaskInProgressCommand, Source={StaticResource ViewModelProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="Completed"
                                                                      Command="{Binding Data.SetTaskCompletedCommand, Source={StaticResource ViewModelProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="Paused"
                                                                      Command="{Binding Data.SetTaskPausedCommand, Source={StaticResource ViewModelProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="Archived"
                                                                      Command="{Binding Data.SetTaskArchivedCommand, Source={StaticResource ViewModelProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                            </Border>
                                                    <ItemsControl ItemsSource="{Binding TagItems}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding Background}"
                                                                        BorderBrush="{Binding BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        Padding="8,3"
                                                                        Margin="0,0,6,6">
                                                                    <TextBlock Text="{Binding Text}"
                                                                               FontSize="11"
                                                                               Foreground="{Binding Foreground}"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Margin="18">
                                            <TextBlock Text="{Binding Description}"
                                                   Foreground="#667085"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,8,0,8" />
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                                Height="10"
                                                Maximum="100"
                                                Margin="0,0,0,12" />
                                            <UniformGrid Columns="3"
                                                         Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="Progress" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MetricValue}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Credits" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding Credits}" Style="{StaticResource MetricValue}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Difficulty" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding Difficulty}" Style="{StaticResource MetricValue}" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,10,8">
                                                    <TextBlock Text="Workload" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding Workload}" FontWeight="SemiBold" Foreground="#111827" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Status" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="#111827" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,8">
                                                    <TextBlock Text="Created" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding CreatedAtText}" FontWeight="SemiBold" Foreground="#111827" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Deadline" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding DeadlineText}" FontWeight="SemiBold" Foreground="#111827" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Ended" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding EndedAtText}" FontWeight="SemiBold" Foreground="#111827" />
                                                </StackPanel>
                                            </UniformGrid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Button Width="28"
                                            Height="28"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,10,10,0"
                                            Content="..."
                                            FontWeight="Bold"
                                            Padding="0"
                                            Click="TaskCardSettings_Click"
                                            Tag="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Изменить" Click="EditTaskMenuItem_Click" />
                                                <MenuItem Header="Удалить"
                                                          Command="{Binding Data.DeleteTaskCommand, Source={StaticResource ViewModelProxy}}"
                                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        <!-- ============================== Side Bar ============================== -->
        <Border
        Grid.Column="0"
        Background="#FFFFFF"
        BorderBrush="#E5E7EB"
        BorderThickness="0,0,1,0"
        Padding="20" Grid.RowSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="10" ShadowDepth="5" />
            </Border.Effect>
            <Grid>
                <StackPanel x:Name="SummaryPanel">
                     <TextBlock Text="Summary"
                       Foreground="#667085"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,100,0,12" />
                    <Button Content="Sort"
                            Height="34"
                            Margin="0,0,0,12"
                            Click="SortButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Status" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Status" />
                                <MenuItem Header="Progress" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Progress" />
                                <MenuItem Header="Name" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Name" />
                                <MenuItem Header="Tags" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Tags" />
                                <MenuItem Header="Deadline" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Deadline" />
                                <MenuItem Header="Created" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Created" />
                                <MenuItem Header="Credits" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Credits" />
                                <MenuItem Header="Workload" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Workload" />
                                <MenuItem Header="Difficulty" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Difficulty" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <UniformGrid Columns="1" Rows="4">
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Courses" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="TotalCoursesText" Text="{Binding TotalCourses}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Tasks" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="TotalTasksText" Text="{Binding TotalTasks}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Avg progress" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="AverageProgressText" Text="{Binding AverageProgressText}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" CornerRadius="6">
                            <StackPanel>
                            <TextBlock Text="Current" Style="{StaticResource MetricLabel}" />
                            <TextBlock x:Name="CurrentCoursesText" Text="{Binding CurrentCourses}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
                <StackPanel x:Name="SelectedCoursePanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Course"
                       Foreground="#667085"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,100,0,12" />
                    <Button Content="Sort tasks"
                            Height="34"
                            Margin="0,0,0,12"
                            Click="SortButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Status" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Status" />
                                <MenuItem Header="Progress" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Progress" />
                                <MenuItem Header="Name" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Name" />
                                <MenuItem Header="Tags" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Tags" />
                                <MenuItem Header="Deadline" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Deadline" />
                                <MenuItem Header="Created" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Created" />
                                <MenuItem Header="Credits" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Credits" />
                                <MenuItem Header="Workload" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Workload" />
                                <MenuItem Header="Difficulty" Command="{Binding Data.SortCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="Difficulty" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock x:Name="SidebarCourseTitle"
                               Text="{Binding SidebarCourseTitle}"
                               Foreground="#111827"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <Border Background="#ECFDF3"
                            BorderBrush="#ABEFC6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8">
                        <TextBlock x:Name="SidebarCourseStatus"
                                   Text="{Binding SidebarCourseStatus}"
                                   Foreground="#027A48"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                    <Border Background="#F9FAFB"
                            BorderBrush="#D0D5DD"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,18">
                        <TextBlock x:Name="SidebarCourseTags"
                                   Text="{Binding SidebarCourseTags}"
                                   Foreground="#344054"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxWidth="170" />
                    </Border>
                    <UniformGrid Columns="1" Rows="8">
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Progress" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseProgress" Text="{Binding SidebarCourseProgress}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Tasks" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseTasks" Text="{Binding SidebarCourseTasks}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Credits" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseCredits" Text="{Binding SidebarCourseCredits}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Difficulty" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseDifficulty" Text="{Binding SidebarCourseDifficulty}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Workload" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseWorkload" Text="{Binding SidebarCourseWorkload}" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Created" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseCreated" Text="{Binding SidebarCourseCreated}" FontWeight="SemiBold" Foreground="#111827" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Deadline" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseDeadline" Text="{Binding SidebarCourseDeadline}" FontWeight="SemiBold" Foreground="#111827" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F9FAFB" Padding="12" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Description" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="SidebarCourseDescription" Text="{Binding SidebarCourseDescription}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#111827" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ============================== App Bar ============================== -->
        <Border Grid.Row="0"
        Grid.ColumnSpan="2"
        Background="#152238"
        Padding="28,18"
        CornerRadius="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.7" BlurRadius="30" ShadowDepth="10" />
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Save"
                            Width="86"
                            Height="34"
                            Margin="0,0,10,0"
                            Command="{Binding SaveCommand}" />
                    <Button Content="Import"
                            Width="86"
                            Height="34"
                            Margin="0,0,10,0"
                            Command="{Binding ImportCommand}" />
                    <Button Content="Settings"
                            Width="96"
                            Height="34"
                            Click="SettingsButton_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Education Dashboard"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="SemiBold" FontFamily="Constantia" />
                    <TextBlock x:Name="HeaderSubtitle"
                       Text="{Binding HeaderSubtitle}"
                       Foreground="#B8C7DA"
                       FontSize="13"
                       />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- ============================== Floating Add Button ============================== -->
        <Button x:Name="FloatingAddButton"
                Grid.Row="1"
                Grid.Column="1"
                Width="58"
                Height="58"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,26,26"
                Padding="0,0,0,8"
                Content="+"
                FontSize="30"
                FontWeight="Bold"
                Foreground="White"
                Background="#32CD32"
                BorderThickness="0"
                BorderBrush ="#32CD32"
                Command="{Binding AddObjectCommand}"
                Style="{StaticResource MaterialDesignFloatingActionButton}">
        </Button>
    </Grid>
</Window>
